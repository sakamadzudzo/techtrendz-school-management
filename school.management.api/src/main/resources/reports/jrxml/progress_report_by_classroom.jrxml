<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="progress_report_by_classroom" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="classroomId" class="java.lang.Long"/>
    <parameter name="entityType" class="java.lang.String"/>
    <queryString>
        <![CDATA[]]>
    </queryString>
    <field name="entityName" class="java.lang.String"/>
    <field name="entityId" class="java.lang.String"/>
    <field name="year" class="java.lang.Integer"/>
    <field name="currentValue" class="java.math.BigDecimal"/>
    <field name="previousValue" class="java.math.BigDecimal"/>
    <field name="percentageChange" class="java.math.BigDecimal"/>
    <field name="trend" class="java.lang.String"/>
    <field name="yearlyData_year" class="java.lang.Integer"/>
    <field name="yearlyData_value" class="java.math.BigDecimal"/>
    <field name="yearlyData_label" class="java.lang.String"/>
    <title>
        <band height="80">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Progress Report - " + $P{entityType}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Classroom: " + $F{entityName} + " (ID: " + $F{entityId} + ")"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="70" width="555" height="1"/>
            </line>
        </band>
    </title>
    <detail>
        <band height="300">
            <!-- Current Year Summary -->
            <frame>
                <reportElement x="0" y="0" width="555" height="60"/>
                <staticText>
                    <reportElement x="0" y="5" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Current Year:]]></text>
                </staticText>
                <textField>
                    <reportElement x="100" y="5" width="50" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{year}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="0" y="20" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Current Value:]]></text>
                </staticText>
                <textField>
                    <reportElement x="100" y="20" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{currentValue}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="0" y="35" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Previous Value:]]></text>
                </staticText>
                <textField>
                    <reportElement x="100" y="35" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{previousValue}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="250" y="5" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Change %:]]></text>
                </staticText>
                <textField>
                    <reportElement x="350" y="5" width="80" height="15"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{percentageChange} + "%"]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="250" y="20" width="100" height="15"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Trend:]]></text>
                </staticText>
                <textField>
                    <reportElement x="350" y="20" width="80" height="15"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{trend}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Chart Section -->
            <frame>
                <reportElement x="0" y="70" width="555" height="230"/>
                <staticText>
                    <reportElement x="0" y="5" width="555" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Year-on-Year Progress Chart]]></text>
                </staticText>

                <!-- Simple Bar Chart Representation -->
                <rectangle>
                    <reportElement x="50" y="30" width="455" height="180"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>

                <!-- Chart Title -->
                <staticText>
                    <reportElement x="50" y="35" width="455" height="15"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Performance Trend]]></text>
                </staticText>

                <!-- Y-Axis Labels -->
                <staticText>
                    <reportElement x="10" y="50" width="35" height="160"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <text><![CDATA[Value]]></text>
                </staticText>

                <!-- X-Axis Labels -->
                <staticText>
                    <reportElement x="50" y="215" width="455" height="15"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <text><![CDATA[Year]]></text>
                </staticText>

                <!-- Chart Bars (simplified representation) -->
                <rectangle>
                    <reportElement x="80" y="60" width="30" height="140"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>

                <rectangle>
                    <reportElement x="120" y="80" width="30" height="120"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>

                <rectangle>
                    <reportElement x="160" y="50" width="30" height="150"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>

                <rectangle>
                    <reportElement x="200" y="70" width="30" height="130"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>

                <rectangle>
                    <reportElement x="240" y="40" width="30" height="160"/>
                    <graphicElement>
                        <pen lineWidth="1"/>
                    </graphicElement>
                </rectangle>
            </frame>
        </band>
    </detail>
    <summary>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Progress Report generated on: " + new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>