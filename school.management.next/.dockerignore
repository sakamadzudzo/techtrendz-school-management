# ===================================================================
# Docker ignore for School Management Next.js Frontend
# ===================================================================
# Files and directories to exclude from Docker build context

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Environment files (use build args instead)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test
coverage/

# TypeScript
*.tsbuildinfo
next-env.d.ts
